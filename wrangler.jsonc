{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "veliq-academy",
  "compatibility_date": "2026-07-19",
  "observability": {
    "enabled": true
  },
  "main": "worker/index.js",
  "assets": {
    "directory": "veliq-academy", "not_found_handling": "404-page",
    "binding": "ASSETS",
    "run_worker_first": ["/api", "/api/*", "/mcp", "/music/catalog", "/music/catalog/*", "/art/catalog", "/art/catalog/*", "/en/art/catalog", "/en/art/catalog/*", "/sitemap-art-catalog.xml", "/robots.txt", "/llms.txt"]
  },
  "kv_namespaces": [
    { "binding": "TRIP" }
  ],
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
